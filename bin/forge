#!/usr/bin/env bash
set -euo pipefail
FORGE_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$FORGE_SOURCE"
case "${1:-}" in
  settings) shift; exec /usr/bin/python3 -m forge.settings "$@";;
  triage|plan|next) exec /usr/bin/python3 -m forge.scheduling "$@";;
  *) exec /usr/bin/python3 -m forge.control "$@";;
esac
