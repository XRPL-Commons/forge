#!/usr/bin/env bash
set -euo pipefail
FORGE_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$FORGE_SOURCE"
usage() {
  cat <<'USAGE'
Usage: bin/forge COMMAND [ARGS...]

Commands:
  setup     Install or configure this host (services, logins, UI)
  update    Update the installed runtime from this checkout
  service   Run the setup supervisor and factory cycle (systemd entry point)
  factory   Inspect or operate the factory controller
  operators Configure GitHub operator sign-in on this host
  settings  Inspect or synchronize GitHub App settings
USAGE
}
case "${1:-}" in
  setup) shift; exec /usr/bin/python3 -m forge.launch forge.host_setup "$@";;
  update) exec /usr/bin/python3 -m forge.launch forge.host_setup "$@";;
  service) shift; exec /usr/bin/python3 -m forge.launch forge.setup_service "$@";;
  factory) shift; exec /usr/bin/python3 -m forge.launch forge.factory.control "$@";;
  operators) shift; exec /usr/bin/python3 -m forge.launch forge.operator_auth "$@";;
  settings) shift; exec /usr/bin/python3 -m forge.launch forge.settings "$@";;
  -h|--help|help) usage;;
  *) usage >&2; exit 2;;
esac
