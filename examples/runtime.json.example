{
  "version": 1,
  "enabled": false,
  "merge_enabled": false,
  "slots": {
    "build": 2,
    "review": 1,
    "audit": 1,
    "recovery": 1
  },
  "cycle_seconds": 30,
  "timeout_seconds": {
    "build": 2700,
    "review": 1200,
    "audit": 1200,
    "recovery": 600
  },
  "grace_seconds": 10,
  "availability_retry_seconds": 300,
  "image": "",
  "engine": "/usr/bin/docker",
  "engine_socket": "/var/run/docker.sock",
  "apparmor_profile": "forge-runner-private-proc",
  "seccomp_profile_env": "FORGE_RUNNER_SECCOMP",
  "network": "forge-workers",
  "proxy": "http://forge-egress:3128",
  "memory": "4g",
  "memory_tiers": [],
  "host_reserve": "2g",
  "cpus": 2,
  "pids_limit": 256,
  "harness_argv": [
    "/usr/local/bin/python3",
    "-I",
    "/opt/forge/harness.py"
  ],
  "provider_environment": [
    "OPENAI_API_KEY"
  ],
  "human_reviewers": [],
  "human_required": false,
  "provider_auth_file_env": null,
  "cycle_budget_seconds": 60,
  "ready_label": "ready",
  "hold_labels": [
    "hold",
    "blocked"
  ],
  "merge_method": "squash",
  "provider": "codex",
  "model": null,
  "provider_ready": null,
  "provider_pool": [
    {
      "id": "codex",
      "provider": "codex",
      "model": null,
      "provider_environment": [
        "OPENAI_API_KEY"
      ],
      "provider_auth_file_env": null
    },
    {
      "id": "claude",
      "provider": "claude",
      "model": null,
      "provider_environment": [
        "ANTHROPIC_API_KEY"
      ],
      "provider_auth_file_env": null
    }
  ]
}
