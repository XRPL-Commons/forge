# Environment variables contain private key FILE PATHS, never key contents.
# Place keys outside the source tree, readable only by the service account.
# Load this file into the forge-status and forge-supervisor service environments.
FORGE_BUILD_KEY_FILE=/srv/forge/credentials/build.pem
FORGE_REVIEW_KEY_FILE=/srv/forge/credentials/review.pem
FORGE_AUDIT_KEY_FILE=/srv/forge/credentials/audit.pem
FORGE_CONTROLLER_KEY_FILE=/srv/forge/credentials/controller.pem
