# Only containers explicitly selecting this profile receive namespace permission.
# Container UID, dropped capabilities, read-only root, private PID namespace and
# internal network remain mandatory. Native Codex adds its filesystem policy.
#include <tunables/global>
profile forge-runner-native flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  userns,
  mount,
  umount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=forge-runner-native,
  ptrace (read,trace,readby,tracedby) peer=forge-runner-native,
  deny /proc/{kcore,kmem,sysrq-trigger} rwklx,
  deny /proc/sys/** wklx,
  deny /sys/** wklx,
}
