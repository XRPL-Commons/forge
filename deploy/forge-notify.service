[Unit]
Description=Deliver durable Forge notification outbox

[Service]
Type=oneshot
WorkingDirectory=%h/ops/forge-watchdog
EnvironmentFile=%h/ops/forge-watchdog/config.env
ExecStart=/usr/bin/python3 -m forge.notifications drain --state %h/ops/forge-watchdog/state/notifications
TimeoutStartSec=55
KillMode=control-group
NoNewPrivileges=yes
UMask=0077
