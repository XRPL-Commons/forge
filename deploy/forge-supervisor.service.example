[Unit]
Description=Forge factory supervisor
After=network-online.target

[Service]
Type=simple
ExecStart=/path/to/forge/bin/forge service --root /path/to/private-runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077

[Install]
WantedBy=default.target
