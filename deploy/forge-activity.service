[Unit]
Description=Forge private local execution activity observer

[Service]
Type=oneshot
WorkingDirectory=%h/ops/forge-watchdog
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m forge.activity --state %h/ops/forge-watchdog/state --config %h/ops/forge-watchdog/repos.d sample
TimeoutStartSec=120
NoNewPrivileges=yes
UMask=0077
