[Unit]
Description=Forge read-only GitHub observability collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/ops/forge-watchdog
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m forge.observability --state %h/ops/forge-watchdog/state --config %h/ops/forge-watchdog/repos.d --days 30 --evidence-limit 8
TimeoutStartSec=1800
NoNewPrivileges=yes
UMask=0077
