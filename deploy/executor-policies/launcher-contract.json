{
  "schema_version": 1,
  "dummy_only": true,
  "provider_activation": false,
  "workspace": "/home/forge/workspace",
  "client": "/home/forge/client",
  "dummy_credential": "/home/forge/client/dummy-credential",
  "providers": {
    "codex": {
      "version": "0.153.2",
      "executable": "/opt/forge/bin/codex",
      "managed_directory": "/etc/codex",
      "client_config": "/home/forge/client/config.toml",
      "environment": {
        "CODEX_HOME": "/home/forge/client"
      },
      "arguments": [
        "exec",
        "--json",
        "-P",
        "forge_dummy_executor",
        "-C",
        "/home/forge/workspace"
      ]
    },
    "claude": {
      "version": "2.1.261",
      "executable": "/opt/forge/bin/claude",
      "managed_directory": "/etc/claude-code",
      "environment": {
        "CLAUDE_CONFIG_DIR": "/home/forge/client",
        "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "DISABLE_AUTOUPDATER": "1"
      },
      "arguments": [
        "-p",
        "--bare",
        "--safe-mode",
        "--restricted",
        "--tools",
        "Bash",
        "--strict-mcp-config",
        "--mcp-config",
        "{\"mcpServers\":{}}",
        "--setting-sources",
        "",
        "--permission-prompts",
        "none",
        "--no-session-persistence",
        "--disable-slash-commands",
        "--output-format",
        "stream-json",
        "--verbose"
      ]
    },
    "grok": {
      "version": "1.0.34",
      "sha256": "be5905e107d2b8b5f3c142d21ecfe4c8fd32a913d2fd551b788707930c4dc80d",
      "executable": "/opt/forge/bin/grok",
      "managed_directory": "/etc/grok",
      "qualification": "pending; optional harness, no native isolation probe has run yet",
      "environment": {
        "GROK_HOME": "/home/forge/client",
        "GROK_DISABLE_AUTOUPDATER": "1",
        "GROK_TELEMETRY_ENABLED": "0",
        "GROK_FEEDBACK_ENABLED": "0"
      },
      "arguments": [
        "--prompt-file",
        "/home/forge/workspace/.forge/prompt.txt",
        "--cwd",
        "/home/forge/workspace",
        "--tools",
        "run_terminal_cmd",
        "--permission-mode",
        "dontAsk",
        "--sandbox",
        "strict",
        "--no-subagents",
        "--disable-web-search",
        "--no-auto-update",
        "--output-format",
        "streaming-messages-json"
      ]
    }
  }
}
