[Unit]
Description=Forge on-demand triage proposals and deterministic GitHub priority updates

[Service]
Type=oneshot
WorkingDirectory=%h/ops/forge-watchdog
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=FORGE_LLM_TRIAGE_ALLOWED=0
Environment=FORGE_TRIAGE_MODE=local
# To opt into model triage, configure an absolute FORGE_CLAUDE_BIN and explicit data authorization.
ExecStart=%h/ops/forge-watchdog/bin/forge triage
TimeoutStartSec=600
KillMode=control-group
NoNewPrivileges=yes
UMask=0077

