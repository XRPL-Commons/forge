[Unit]
Description=Forge private dashboard
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /path/to/forge/legacy/forge-status.py
Environment=PYTHONPATH=/path/to/forge
Environment=FORGE_ROOT=/path/to/private-runtime
Environment=FORGE_BIND_ADDRESS=127.0.0.1
Environment=FORGE_PORT=8788
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
