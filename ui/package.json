    "@nuxt/test-utils": "^4.3.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "2.2.12"
  }
