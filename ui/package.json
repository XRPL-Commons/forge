    "sanitize-html": "^2.18.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.135",
    "@nuxt/test-utils": "^4.3.2",
    "@types/sanitize-html": "^2.16.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "2.2.12"
  }
